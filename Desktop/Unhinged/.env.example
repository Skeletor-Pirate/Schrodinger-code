# Environment Variables Template for Unhinged Platform
# Copy this file to .env and fill in the appropriate values

# ===== DATABASE CONFIGURATION =====
# PostgreSQL database connection
DATABASE_URL="postgresql://username:password@localhost:5432/unhinged?schema=public"

# ===== REDIS CONFIGURATION =====
# Redis connection for session storage and caching
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ===== MINIO OBJECT STORAGE =====
# MinIO S3-compatible object storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL=false

# ===== GOOGLE OAUTH 2.0 =====
# Google OAuth credentials for authentication
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

# ===== OPENAI API =====
# OpenAI API for embeddings and LLM features
OPENAI_API_KEY="your-openai-api-key"

# ===== SECURITY CONFIGURATION =====
# JWT secret for token signing (32+ byte random string)
JWT_SECRET="your-32-byte-random-secret-here"

# Encryption key for AES-256-GCM (32 byte hex encoded)
ENCRYPTION_KEY="your-32-byte-hex-encoded-key-here"

# ===== EMAIL SERVICE CONFIGURATION =====
# SMTP configuration for sending notifications
# Example for Gmail (enable 2FA and use app password)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="username"
SMTP_PASS="password"
SMTP_FROM="noreply@unhinged.app"

# ===== OPTIONAL SERVICE CONFIGURATION =====
# Search API (Google Custom Search, Bing, etc.)
SEARCH_API_KEY="your-search-api-key"
SEARCH_API_URL="https://api.search-service.com/search"

# Hackathon API (Devpost, Hackerearth, etc.)
HACKATHON_API_URL="https://api.hackathon-service.com/events"
HACKATHON_API_KEY="your-hackathon-api-key"

# Plugin sandbox service
PLUGIN_SANDBOX_URL="http://localhost:3001"

# ===== MEMORY SUMMARIZATION WORKER =====
# Configuration for memory summarization worker (optional)
MEMORY_SUMMARIZATION_INTERVAL_HOURS=24
MEMORY_SUMMARIZATION_BATCH_SIZE=100
MEMORY_MAX_AGE_FOR_SUMMARIZATION_DAYS=30

# ===== NEXT.JS CONFIGURATION =====
# Next.js application URLs and secrets
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="nextauth-secret-here-32-bytes"

# ===== FEATURE FLAGS =====
# Enable/disable features (set to true/false)
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_MFA=false
ENABLE_RATE_LIMITING=true
ENABLE_PLUGIN_MARKETPLACE=false
ENABLE_CUSTOM_AGENT_TRAINING=false