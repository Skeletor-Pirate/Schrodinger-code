// Prisma Schema for UNHINGED Platform
// This defines the database structure for the application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  display_name        String
  avatar_url          String?
  status              String   @default("pending") // pending, active, suspended, banned
  role                String   @default("member") // admin, moderator, member, guest
  google_id           String?  @unique
  mfa_enabled         Boolean  @default(false)
  primary_workspace_id String?
  created_at          DateTime @default(now())
  last_login_at       DateTime?
  deleted_at          DateTime?

  // Password reset fields
  password_reset_token String?
  password_reset_expires DateTime?

  // Hashed password for non-Google auth (though primarily using Google OAuth)
  password            String?

  // Relations
  workspaceMembers    WorkspaceMember[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([google_id])
  @@index([status])
}

model Workspace {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  owner_user_id     String
  visibility        String   @default("public") // public, private, unlisted
  retention_policy  String   @default("forever") // forever, 1year, 6months, 3months, 1month
  e2ee_enabled      Boolean  @default(false)
  vault_path        String
  max_members       Int      @default(100)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  owner             User       @relation(fields: [owner_user_id], references: [id])
  workspaceMembers  WorkspaceMember[]
  groups            Group[]

  @@index([slug])
  @@index([owner_user_id])
  @@index([visibility])
}

model WorkspaceMember {
  id           String   @id @default(uuid())
  user_id      String
  workspace_id String
  role         String   @default("member") // owner, admin, moderator, member
  status       String   @default("active") // active, inactive
  joined_at    DateTime @default(now())
  muted_until  DateTime?

  // Relations
  user         User @relation(fields: [user_id], references: [id])
  workspace    Workspace @relation(fields: [workspace_id], references: [id])

  @@unique([user_id, workspace_id])
  @@index([workspace_id])
  @@index([user_id])
}

model Group {
  id              String   @id @default(uuid())
  workspace_id    String
  name            String
  description     String?
  type            String   @default("team") // team, project, department, custom
  visibility      String   @default("workspace") // workspace, public, private
  agent_enabled   Boolean  @default(false)
  archived_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  workspace       Workspace @relation(fields: [workspace_id], references: [id])
  auditLogs       AuditLog[]

  @@index([workspace_id])
  @@index([visibility])
}

model AuditLog {
  id           String   @id @default(uuid())
  user_id      String?
  action       String
  resource_type String
  resource_id  String?
  details      Json?
  ip_address   String?
  user_agent   String?
  timestamp    DateTime @default(now())

  // Relations
  user         User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([timestamp])
  @@index([action])
}

// Add any additional models as needed for the platform

model Memory {
  id            String   @id @default(uuid())
  content       String
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}